# ============================================
# CAU HINH WORKFLOW DANG BAI TU DONG
# Copy file nay thanh .env va dien thong tin
# ============================================

# --- Facebook ---
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_ACCESS_TOKEN=your_page_access_token

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=your_access_token
LINKEDIN_PERSON_URN=urn:li:person:your_person_id
# Neu dang len Company Page, dung LINKEDIN_ORG_URN thay cho PERSON_URN
LINKEDIN_ORG_URN=

# --- Google Sheets ---
GOOGLE_SHEETS_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Sheet1

# --- Database ---
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auto_posting
DB_USER=root
DB_PASSWORD=your_password

# --- Scheduler ---
# Dinh dang: HH:MM (vd: 09:00, 14:30)
SCHEDULE_DAILY_TIME=09:00
# Interval tinh bang phut cho che do hang gio
SCHEDULE_HOURLY_INTERVAL=60

# --- Content Source ---
# google_sheets | database | both
CONTENT_SOURCE=both

# --- Logging ---
LOG_LEVEL=INFO
